# Copia este archivo como .env.local y llena los valores reales.
# .env.local NUNCA se sube a git (ya está en .gitignore).

# URL pública del sitio (en local déjala así; en producción, tu dominio)
NEXT_PUBLIC_URL=http://localhost:3000

# ——— Mercado Pago ———
# 1. Crea tu cuenta en https://www.mercadopago.com.mx/developers
# 2. Crea una aplicación → Credenciales de producción
# 3. Copia el Access Token aquí (empieza con APP_USR-)
MP_ACCESS_TOKEN=

# 4. En "Webhooks" configura la URL: https://TU-DOMINIO/api/webhooks/mercadopago
#    (evento: Pagos) y copia la clave secreta que te da aquí:
MP_WEBHOOK_SECRET=
